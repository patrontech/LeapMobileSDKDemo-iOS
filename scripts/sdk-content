#!/usr/bin/env -S zsh -f
#
# sdk-content [project] [environment]
#
# Puts a CMS project's content and secrets into DemoSDK, the way a partner's SDK package will embed
# them. Fetches the project into the turbopump cache (this needs AWS credentials: `aws sso login`),
# then copies its runConfig.json and initial content zip into DemoSDK's resources and generates
# DemoSDK's Secrets.swift. Neither is committed.
#
# Defaults to fanaticssdkstaging-2025 in preprod.

setopt ERR_EXIT NO_UNSET PIPE_FAIL

root=${0:A:h:h}
project=${1:-fanaticssdkstaging-2025}
environment=${2:-preprod}
package=$root/DemoSDK/Sources/DemoSDK

cd $root
export turbo_project=$project turbo_environment=$environment
mise exec -- turbopump fetch

cache=~/.turbopump/cache/$environment/$project/initial
resources=$package/Resources
rm -f $resources/(runConfig.json|content_v*.zip)(N)
cp $cache/runConfig.json $cache/content_v*.zip $resources/

secrets=$package/Generated/Secrets.swift
mkdir -p ${secrets:h}
{
  print "// Generated by scripts/sdk-content from $project ($environment). Do not edit, and never commit."
  print
  print "enum Secrets {"
  print "  static let all: [String: String] = ["
  jq -r '.secrets | to_entries[] | "    \(.key | @json): \(.value | @json),"' $cache/buildConfig.json
  print "  ]"
  print "}"
} > $secrets

print "DemoSDK now embeds $project ($environment): $(cd $resources && print content_v*.zip)"
